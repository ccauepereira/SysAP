# Local development environment. Copy values into your shell or local tooling;
# the API does not load this file automatically.
SYSAP_ENV=development
SYSAP_HTTP_ADDR=127.0.0.1:8080

# Optional. Run `pnpm db:env` after starting Supabase to fill local values.
SYSAP_DATABASE_URL=
SYSAP_TEST_DATABASE_URL=

SYSAP_SHUTDOWN_TIMEOUT=10s
SYSAP_DATABASE_PING_TIMEOUT=2s

# Required together when a protected API route is introduced. Keep these as
# non-secret placeholders; the API fetches the public JWKS only at request time.
SYSAP_AUTH_JWT_ISSUER=
SYSAP_AUTH_JWT_AUDIENCE=
SYSAP_AUTH_JWKS_URL=
SYSAP_AUTH_JWKS_TIMEOUT=2s
SYSAP_AUTH_JWKS_CACHE_TTL=5m
SYSAP_AUTH_JWKS_MAX_BODY_LENGTH=65536
SYSAP_AUTH_JWKS_MAX_KEYS=16
SYSAP_OTP_PEPPER=
# At least 32 bytes. Used only to HMAC normalized IP plus enrollment for the
# persistent login rate limit; never commit a real value.
SYSAP_LOGIN_RATE_LIMIT_SECRET=
SYSAP_PASSWORD_RECOVERY_PEPPER=

# Local OTP provider for development and tests only. Production SMS is
# configured as the Supabase Auth provider outside this repository.
SYSAP_SMS_PROVIDER=local

# Supabase Auth Admin endpoint. HTTP is accepted only for explicit local/test
# loopback environments; production requires HTTPS.
SYSAP_SUPABASE_AUTH_URL=
SYSAP_SUPABASE_SERVICE_ROLE_KEY=
